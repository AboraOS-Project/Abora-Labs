module GuardTests;

# Mirrors ../shared/*.tsv by hand: Vanta 0.1 cannot read files.
# Keep these in the same order as the vector files. Cases this port cannot
# express are reported as SKIP rather than silently dropped.

func Check(let name::string, let got::bool, let want::bool)::void {
    if got == want {
        emit("LABS-TEST: PASS {name}");
    } else {
        emit("LABS-TEST: FAIL {name}");
    }
}

func Skip(let name::string)::void {
    emit("LABS-TEST: SKIP {name} (needs string operations)");
}

func Start()::void {
    Skip("tag_base_version v4.1-DEMO2");
    Skip("tag_base_version v4.0-EVEREST-ALPHA");
    Skip("tag_base_version v3.14");
    Skip("tag_base_version 4.0");
    Skip("tag_base_version edge");
    Skip("tag_base_version test-prealpha");
    Skip("tag_base_version v");

    let block = false;
    let allow = true;
    Check("4.0 -> v3.14 allow_downgrade=no", Allows(4, 0, 0, "v3.14", 3, 14, 0, false), block);
    Check("4.0 -> v3.14 allow_downgrade=yes", Allows(4, 0, 0, "v3.14", 3, 14, 0, true), allow);
    Check("4.0 -> edge allow_downgrade=no", Allows(4, 0, 0, "edge", 0, 0, 0, false), allow);
    Check("3.14 -> v4.0 allow_downgrade=no", Allows(3, 14, 0, "v4.0", 4, 0, 0, false), allow);
    Skip("4.0 -> test-prealpha allow_downgrade=no");
    Check("4.0 -> v4.0 allow_downgrade=no", Allows(4, 0, 0, "v4.0", 4, 0, 0, false), allow);
    Check("4.0.1 -> v4.0 allow_downgrade=no", Allows(4, 0, 1, "v4.0", 4, 0, 0, false), block);
    Check("4.0 -> v4.0.0 allow_downgrade=no", Allows(4, 0, 0, "v4.0.0", 4, 0, 0, false), allow);
    Check("4.0 -> v4.0-EVEREST-ALPHA allow_downgrade=no", Allows(4, 0, 0, "v4.0-EVEREST-ALPHA", 4, 0, 0, false), allow);
    Check("4.1 -> v4.0-DEMO2 allow_downgrade=no", Allows(4, 1, 0, "v4.0-DEMO2", 4, 0, 0, false), block);
    Check("4.10 -> v4.9 allow_downgrade=no", Allows(4, 10, 0, "v4.9", 4, 9, 0, false), block);
    Check("4.9 -> v4.10 allow_downgrade=no", Allows(4, 9, 0, "v4.10", 4, 10, 0, false), allow);
    Check("10.0 -> v9.99 allow_downgrade=no", Allows(10, 0, 0, "v9.99", 9, 99, 0, false), block);
    Skip("4.0 -> v99999999999.0 allow_downgrade=no");
}
