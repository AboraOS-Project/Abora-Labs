# Spec: experiments/updater/shared/README.md
#
# Vanta 0.1 has no string indexing, loops or collections, so this port covers
# only the numeric part of the spec: versions arrive already split into
# major/minor/patch integers (missing parts are 0, exactly as the spec says).
# The caller passes the original ref too, so `edge` is still recognised.
# Not representable yet: tag_base_version, non-numeric refs, the 32-bit bound.
#
# This file has no `module` line or `Start`: the Makefile appends it to
# src/main.vanta and tests/main_test.vanta, standing in for imports.

func CompareInt(let a::int, let b::int)::int {
    if a < b {
        return -1;
    }
    if a > b {
        return 1;
    }
    return 0;
}

func CompareVersions(let a1::int, let a2::int, let a3::int, let b1::int, let b2::int, let b3::int)::int {
    let major = CompareInt(a1, b1);
    if major != 0 {
        return major;
    }
    let minor = CompareInt(a2, b2);
    if minor != 0 {
        return minor;
    }
    return CompareInt(a3, b3);
}

func Allows(let current1::int, let current2::int, let current3::int, let selectedRef::string, let selected1::int, let selected2::int, let selected3::int, let allowDowngrade::bool)::bool {
    if selectedRef == "edge" {
        return true;
    }
    if allowDowngrade {
        return true;
    }
    return CompareVersions(selected1, selected2, selected3, current1, current2, current3) >= 0;
}
